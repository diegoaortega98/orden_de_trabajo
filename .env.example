PORT=3000
NODE_ENV=development

# URI de MongoDB Atlas o de una instancia local
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/otm_institucion?retryWrites=true&w=majority

# URL pública de la página del formulario, utilizada en el código QR
PUBLIC_FORM_URL=http://localhost:3000/

# Origen permitido por CORS. En producción, usa la URL de tu aplicación Render.
# Para varios orígenes, sepáralos con comas.
FRONTEND_ORIGIN=http://localhost:3000

# Token secreto para las operaciones administrativas.
# Genera uno largo y aleatorio; no lo compartas ni lo publiques.
ADMIN_TOKEN=cambia-esto-por-un-secreto-largo-y-aleatorio

# Datos institucionales que aparecen en el PDF
INSTITUTION_NAME=Institución Educativa
INSTITUTION_EMAIL=mantenimiento@institucion.edu

# SMTP. Si se dejan vacíos, el sistema guarda la OT e informa que el correo no está configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Email opcional de destino por defecto para los PDF
OT_EMAIL_TO=
